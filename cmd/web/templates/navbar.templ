package templates

import "thirdcoast.systems/rewind/cmd/web/ctxkeys"

// Navbar groups archive destinations and tools in one responsive navigation.
templ Navbar(username string) {
	{{ accessLevel, _ := ctx.Value(ctxkeys.AccessLevel).(string) }}
	{{ registrationEnabled, _ := ctx.Value(ctxkeys.RegistrationEnabled).(bool) }}
	<nav id="main-nav" class="site-nav" aria-label="Main navigation" data-signals="{_navOpen: false}" data-on:keydown="if (evt.key === 'Escape') { $_navOpen = false; el.querySelectorAll('details[open]').forEach(d => d.open = false); el.querySelector('[data-nav-toggle]')?.focus() }" data-on:click__outside="$_navOpen = false">
		<a href="/" class="site-nav-brand" aria-label="Rewind home">
			<i class="fa-sharp fa-solid fa-video" aria-hidden="true"></i>
			<span>REWIND</span>
		</a>
		if accessLevel != "unauthenticated" {
			<div class="site-nav-library" aria-label="Library">
				@navPrimary("/videos", "Videos")
				@navPrimary("/channels", "Channels")
				@navPrimary("/creators", "Creators")
				@navPrimary("/follows", "Follows")
			</div>
		}
		if username != "" {
			<button type="button" class="site-nav-agent" data-agent-toggle data-on:click="$agentOpen = !$agentOpen" aria-controls="rewind-agent" aria-expanded="false" data-attr:aria-expanded="$agentOpen ? 'true' : 'false'">
				<i class="fa-sharp fa-solid fa-comment" aria-hidden="true"></i>Assistant
			</button>
		}
		if accessLevel != "unauthenticated" {
			<button type="button" class="site-nav-toggle" data-nav-toggle data-on:click="$_navOpen = !$_navOpen" aria-controls="site-nav-menu" aria-expanded="false" data-attr:aria-expanded="$_navOpen ? 'true' : 'false'">
				<i class="fa-sharp fa-solid fa-bars" aria-hidden="true"></i>
				Menu
			</button>
			<div id="site-nav-menu" class="site-nav-menu" data-class:is-open="$_navOpen">
				<div class="site-nav-destinations">
					@navGroup("Explore", "Discover connections", false) {
						@navDestination("/visual", "Visual search", "images")
						@navDestination("/network", "Network", "diagram-project")
						@navDestination("/investigate", "Investigate", "magnifying-glass")
						@navDestination("/wiki", "Wiki", "book")
					}
					@navGroup("Studio", "Build something from your archive", false) {
						@navDestination("/compilations", "Compilations", "layer-group")
						@navDestination("/stitch", "Stitch", "film")
						@navDestination("/show-notes", "Show notes", "list-check")
					}
					<a href="/jobs" class="site-nav-direct" data-attr:aria-current="window.location.pathname.startsWith('/jobs') ? 'page' : null">Jobs</a>
				</div>
				<div class="site-nav-utilities">
					<a href="/upload" class="site-nav-upload"><i class="fa-sharp fa-solid fa-plus" aria-hidden="true"></i>Upload</a>
					@navGroup("Account", username, true) {
						@navDestination("/settings", "Settings", "gear")
						if accessLevel == "admin" {
							<p class="site-nav-section-label">Administration</p>
							@navDestination("/admin", "Dashboard", "gauge-high")
							@navDestination("/admin/settings", "Instance", "sliders")
							@navDestination("/admin/users", "Users", "users")
							@navDestination("/admin/exports", "Exports", "file-export")
							@navDestination("/admin/asset-health", "Asset health", "heart-pulse")
							@navDestination("/admin/database", "Database", "database")
							<form method="POST" action="/admin/refresh-assets">
								<button type="submit" class="site-nav-item"><i class="fa-sharp fa-solid fa-arrows-rotate" aria-hidden="true"></i>Refresh assets</button>
							</form>
						}
						<div class="site-nav-section-label">Session</div>
						@navDestination("/logout", "Log out", "right-from-bracket")
					}
				</div>
			</div>
		} else {
			<div class="site-nav-auth">
				<a href="/login" class="site-nav-direct">Log in</a>
				if registrationEnabled {
					<a href="/register" class="site-nav-upload">Register</a>
				}
			</div>
		}
	</nav>
}

templ navPrimary(href, label string) {
	<a href={ templ.SafeURL(href) } class="site-nav-direct" data-attr:aria-current={ "(window.location.pathname === '" + href + "' || window.location.pathname.startsWith('" + href + "/')) ? 'page' : null" }>{ label }</a>
}

templ navGroup(label, description string, alignRight bool) {
	<details class={ "site-nav-group", templ.KV("site-nav-group-end", alignRight) } name="site-navigation" data-on:click__outside="el.open = false" data-on:keydown="if (evt.key === 'Escape') { evt.stopPropagation(); el.open = false; el.querySelector('summary').focus() }">
		<summary>{ label }<i class="fa-sharp fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
		<div class="site-nav-dropdown">
			<p class="site-nav-description">{ description }</p>
			{ children... }
		</div>
	</details>
}

templ navDestination(href, label, icon string) {
	<a href={ templ.SafeURL(href) } class="site-nav-item" data-attr:aria-current={ "(window.location.pathname === '" + href + "' || ('" + href + "' !== '/admin' && window.location.pathname.startsWith('" + href + "/'))) ? 'page' : null" }>
		<i class={ "fa-sharp fa-solid fa-" + icon } aria-hidden="true"></i>
		{ label }
	</a>
}
