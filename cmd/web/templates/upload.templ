package templates

import "thirdcoast.systems/rewind/cmd/web/ctxkeys"

templ Upload(username string) {
	@Layout("Upload", username) {
		{{ liveProduct, _ := ctx.Value(ctxkeys.LiveProduct).(bool) }}
		@Container("") {
			<div class="mb-4">
				<h1 class="page-heading text-xl tracking-tight mb-0.5">Upload Video</h1>
				<p class="text-xs font-mono text-white/60">Upload a local video file to your archive</p>
			</div>
			<div
				id="upload-zone"
				class="border-2 border-dashed border-white/20 p-8 text-center transition-colors hover:border-white/40 cursor-pointer"
				ondragover="event.preventDefault(); this.classList.add('border-white', 'bg-white/5')"
				ondragleave="this.classList.remove('border-white', 'bg-white/5')"
				ondrop="handleDrop(event)"
				onclick="document.getElementById('file-input').click()"
			>
				<div id="upload-prompt">
					<i class="fa-sharp fa-solid fa-cloud-arrow-up text-4xl text-white/20 mb-3" aria-hidden="true"></i>
					<p class="font-mono text-sm text-white/60 mb-1">Drag & drop video files here</p>
					<p class="font-mono text-xs text-white/40">or click to browse</p>
					<p class="font-mono text-xs text-white/30 mt-2">
						MP4, MKV, WebM, AVI, MOV, FLV, WMV, MPG, and more
					</p>
				</div>
				<input
					type="file"
					id="file-input"
					class="hidden"
					accept="video/*,.mkv,.avi,.wmv,.flv,.mpg,.mpeg,.m4v,.ts,.mts,.m2ts,.vob,.3gp,.ogv,.divx,.asf,.f4v,.rm,.rmvb"
					multiple
					onchange="handleFiles(this.files)"
				/>
			</div>
			<div id="upload-list" class="mt-4 space-y-2"></div>
		}
		<script>
			const liveProduct = {{ liveProduct }};
			const TUS_CHUNK_BYTES = 52428800;
			const TUS_RESUME_ATTEMPTS = 5;

			function handleDrop(e) {
				e.preventDefault();
				e.currentTarget.classList.remove('border-white', 'bg-white/5');
				handleFiles(e.dataTransfer.files);
			}

			function handleFiles(files) {
				const selected = Array.from(files);
				// Reset the input so the same file can be re-selected
				document.getElementById('file-input').value = '';
				if (liveProduct) {
					uploadLiveFiles(selected);
					return;
				}
				for (const file of selected) {
					uploadFile(file);
				}
			}

			function formatBytes(bytes) {
				if (bytes === 0) return '0 B';
				const k = 1024;
				const sizes = ['B', 'KB', 'MB', 'GB'];
				const i = Math.floor(Math.log(bytes) / Math.log(k));
				return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
			}

			function tusB64(value) {
				const bytes = new TextEncoder().encode(String(value));
				let binary = '';
				for (let i = 0; i < bytes.length; i++) {
					binary += String.fromCharCode(bytes[i]);
				}
				return btoa(binary);
			}

			function tusMetadata(key, filename) {
				return 'key ' + tusB64(key) + ',filename ' + tusB64(filename);
			}

			function resolveLocation(uploadUrl, location) {
				const base = new URL(uploadUrl, window.location.href);
				return new URL(location, base).href;
			}

			function setUploadProgress(card, loaded, total) {
				if (!total) return;
				const pct = (loaded / total * 100).toFixed(0);
				card.querySelector('.upload-progress').style.width = pct + '%';
			}

			function markUploadFailed(card, label, detail) {
				const bar = card.querySelector('.upload-progress');
				const status = card.querySelector('.upload-status');
				bar.classList.remove('bg-white');
				bar.classList.add('bg-red-500');
				bar.style.width = '100%';
				status.textContent = label;
				if (!detail) return;
				const err = document.createElement('p');
				err.className = 'font-mono text-xs text-white/40 mt-1';
				err.textContent = detail;
				card.querySelector('.flex-1').appendChild(err);
			}

			function markUploadDone(card) {
				const bar = card.querySelector('.upload-progress');
				const status = card.querySelector('.upload-status');
				bar.style.width = '100%';
				status.textContent = 'Done';
				status.classList.remove('text-white/60');
				status.classList.add('text-white');
				card.classList.remove('border-white/10');
				card.classList.add('border-white/20');
			}

			async function readError(res) {
				try {
					const resp = await res.json();
					if (resp && resp.error) return String(resp.error);
				} catch (e) {}
				return '';
			}

			function patchChunk(location, offset, blob, onLoaded) {
				return new Promise((resolve, reject) => {
					const xhr = new XMLHttpRequest();
					xhr.open('PATCH', location);
					xhr.setRequestHeader('Tus-Resumable', '1.0.0');
					xhr.setRequestHeader('Upload-Offset', String(offset));
					xhr.setRequestHeader('Content-Type', 'application/offset+octet-stream');
					xhr.upload.onprogress = (e) => {
						if (e.lengthComputable) onLoaded(e.loaded);
					};
					xhr.onload = () => resolve(xhr);
					xhr.onerror = () => reject(new Error('network'));
					xhr.send(blob);
				});
			}

			async function readUploadOffset(location) {
				const res = await fetch(location, {
					method: 'HEAD',
					cache: 'no-store',
					headers: { 'Tus-Resumable': '1.0.0' },
				});
				if (!res.ok) throw new Error('HEAD failed');
				const value = parseInt(res.headers.get('Upload-Offset') || '', 10);
				if (!Number.isFinite(value) || value < 0) throw new Error('missing offset');
				return value;
			}

			async function uploadLiveFiles(files) {
				let lastId = '';
				for (const file of files) {
					const videoId = await uploadFileLive(file);
					if (!videoId) return;
					lastId = videoId;
				}
				if (lastId) {
					window.location.href = '/videos/' + encodeURIComponent(lastId);
				}
			}

			async function uploadFileLive(file) {
				const card = createUploadCard(file);
				try {
					const createdRes = await fetch('/api/uploads', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ filename: file.name }),
					});
					if (!createdRes.ok) {
						markUploadFailed(card, 'Failed', (await readError(createdRes)) || 'Upload failed');
						return '';
					}
					const created = await createdRes.json();
					if (!created.uploadUrl || !created.videoId || !created.key) {
						markUploadFailed(card, 'Failed', 'Upload failed');
						return '';
					}

					const createRes = await fetch(created.uploadUrl, {
						method: 'POST',
						cache: 'no-store',
						headers: {
							'Tus-Resumable': '1.0.0',
							'Upload-Length': String(file.size),
							'Upload-Metadata': tusMetadata(created.key, file.name),
						},
					});
					if (!createRes.ok) {
						markUploadFailed(card, 'Failed', 'Upload failed');
						return '';
					}
					const loc = createRes.headers.get('Location');
					if (!loc) {
						markUploadFailed(card, 'Failed', 'Upload failed');
						return '';
					}
					const location = resolveLocation(created.uploadUrl, loc);

					let offset = 0;
					let misses = 0;
					while (offset < file.size) {
						const end = Math.min(offset + TUS_CHUNK_BYTES, file.size);
						let xhr = null;
						try {
							xhr = await patchChunk(location, offset, file.slice(offset, end), (loaded) => {
								setUploadProgress(card, offset + loaded, file.size);
							});
						} catch (e) {
							xhr = null;
						}
						if (!xhr || xhr.status === 409) {
							misses++;
							if (misses > TUS_RESUME_ATTEMPTS) {
								markUploadFailed(card, xhr ? 'Failed' : 'Error');
								return '';
							}
							try {
								offset = await readUploadOffset(location);
							} catch (e) {
								markUploadFailed(card, 'Error');
								return '';
							}
							setUploadProgress(card, offset, file.size);
							continue;
						}
						if (xhr.status < 200 || xhr.status >= 300) {
							markUploadFailed(card, 'Failed', 'Upload failed');
							return '';
						}
						const headerOffset = parseInt(xhr.getResponseHeader('Upload-Offset') || '', 10);
						const next = Number.isFinite(headerOffset) ? headerOffset : end;
						if (next <= offset) {
							markUploadFailed(card, 'Failed', 'Upload failed');
							return '';
						}
						misses = 0;
						offset = next;
						setUploadProgress(card, offset, file.size);
					}
					if (offset !== file.size) {
						markUploadFailed(card, 'Failed', 'Upload failed');
						return '';
					}

					const doneRes = await fetch('/api/uploads/' + encodeURIComponent(created.videoId) + '/complete', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ filename: file.name }),
					});
					if (!doneRes.ok) {
						markUploadFailed(card, 'Failed', (await readError(doneRes)) || 'Upload failed');
						return '';
					}
					markUploadDone(card);
					const link = document.createElement('a');
					link.href = '/videos/' + encodeURIComponent(created.videoId);
					link.className = 'font-mono text-xs text-white/40 hover:text-white underline mt-1 inline-block';
					link.textContent = 'View video →';
					card.querySelector('.flex-1').appendChild(link);
					return created.videoId;
				} catch (e) {
					markUploadFailed(card, 'Error');
					return '';
				}
			}

			function createUploadCard(file) {
				const id = 'upload-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
				const list = document.getElementById('upload-list');

				const card = document.createElement('div');
				card.id = id;
				card.className = 'border-2 border-white/10 p-3';
				card.innerHTML = `
					<div class="flex items-center justify-between mb-2">
						<div class="flex-1 min-w-0">
							<p class="font-mono text-sm text-white truncate">${file.name}</p>
							<p class="font-mono text-xs text-white/40">${formatBytes(file.size)}</p>
						</div>
						<span class="upload-status font-mono text-xs uppercase tracking-wider text-white/60 ml-3">Uploading…</span>
					</div>
					<div class="w-full h-1 bg-white/10">
						<div class="upload-progress h-full bg-white transition-all duration-200" style="width: 0%"></div>
					</div>
				`;
				list.prepend(card);
				return card;
			}

			function uploadFile(file) {
				const card = createUploadCard(file);

				const form = new FormData();
				form.append('file', file);

				const xhr = new XMLHttpRequest();
				xhr.open('POST', '/api/upload');

				xhr.upload.onprogress = (e) => {
					if (e.lengthComputable) {
						const pct = (e.loaded / e.total * 100).toFixed(0);
						const bar = card.querySelector('.upload-progress');
						bar.style.width = pct + '%';
					}
				};

				xhr.onload = () => {
					const bar = card.querySelector('.upload-progress');
					const status = card.querySelector('.upload-status');

					if (xhr.status === 200) {
						bar.style.width = '100%';
						status.textContent = 'Queued';
						status.classList.remove('text-white/60');
						status.classList.add('text-white');
						card.classList.remove('border-white/10');
						card.classList.add('border-white/20');

						try {
							const resp = JSON.parse(xhr.responseText);
							const link = document.createElement('a');
							link.href = '/jobs/' + resp.download_job_id;
							link.className = 'font-mono text-xs text-white/40 hover:text-white underline mt-1 inline-block';
							link.textContent = 'View job →';
							card.querySelector('.flex-1').appendChild(link);
						} catch (e) {}
					} else {
						bar.classList.remove('bg-white');
						bar.classList.add('bg-red-500');
						bar.style.width = '100%';
						status.textContent = 'Failed';

						try {
							const resp = JSON.parse(xhr.responseText);
							const err = document.createElement('p');
							err.className = 'font-mono text-xs text-white/40 mt-1';
							err.textContent = resp.error || 'Upload failed';
							card.querySelector('.flex-1').appendChild(err);
						} catch (e) {}
					}
				};

				xhr.onerror = () => {
					const bar = card.querySelector('.upload-progress');
					const status = card.querySelector('.upload-status');
					bar.classList.remove('bg-white');
					bar.classList.add('bg-red-500');
					bar.style.width = '100%';
					status.textContent = 'Error';
				};

				xhr.send(form);
			}
		</script>
	}
}
