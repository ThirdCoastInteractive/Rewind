package templates

import (
	"fmt"
	"thirdcoast.systems/rewind/cmd/web/ctxkeys"
	"thirdcoast.systems/rewind/internal/db"
	"time"
)

// VideoProcessing renders generated-data controls and the video's ML job history.
templ VideoProcessing(videoID string, jobs []*db.MlJob, health []*db.MlRuntimeHealth, hasTranscript bool, windows int) {
	{{ liveProduct, _ := ctx.Value(ctxkeys.LiveProduct).(bool) }}
	{{ lead := "Captions → transcript → context windows. Context generation uses the local ML worker. Explicit requests run ahead of background context work." }}
	if liveProduct {
		{{ lead = "Captions → transcript → context windows. Context is built from the transcript. Explicit requests run ahead of background context work." }}
	}
	<div id="video-processing" class="recording-generated">
		<div class="recording-generated-head">
		<h3 class="font-bold text-sm">Generated data</h3>
		<p class="text-xs text-white/60">{ lead }</p>
		<p class="text-xs font-mono">{ generatedDataSummary(jobs, health, hasTranscript, windows) }</p>
		<div class="flex flex-wrap gap-2">
			if !hasTranscript {
				<button type="button" class="btn-ghost btn-sm disabled:opacity-50" data-indicator:captions-queuing data-attr:disabled="$captionsQueuing" data-on:click={ fmt.Sprintf("@post('/api/videos/%s/regenerate-assets?render=1&scope=captions')", videoID) }>Generate captions</button>
			}
			<button type="button" class="btn-ghost btn-sm disabled:opacity-50" disabled={ !hasTranscript } data-indicator:context-queuing data-attr:disabled={ fmt.Sprintf("%t || $contextQueuing", !hasTranscript) } data-on:click={ fmt.Sprintf("@post('/api/videos/%s/context-windows/generate?render=1')", videoID) }>Generate context</button>
			<a class="btn-ghost btn-sm" href="/jobs?tab=processing">All jobs</a>
			<a class="btn-ghost btn-sm" href="/admin/settings#settings-models">Model settings</a>
		</div>
		<p class="text-xs text-white/50">Existing context for the current transcript and model is reused. Captions and media asset controls are above. Status refreshes every 5 seconds.</p>
		</div>
		<div class="generated-status">
		for _, h := range relevantMLHealth(jobs, health, hasTranscript) {
			{{ hc := mlErrorCopy(h.LastError) }}
			<div class="text-xs font-mono border border-white/20 p-2 space-y-1 break-words">
				<p>
					<strong>{ mlRuntimeHeadline(h.Kind) }: </strong>{ hc.Headline }
				</p>
				if hc.Detail != "" {
					<details class="text-white/50">
						<summary>Details</summary>
						<p class="break-words">{ hc.Detail }</p>
					</details>
				}
				if cd := mlHealthCooldown(h); cd != "" {
					<p class="text-white/50">{ cd }</p>
				}
			</div>
		}
		if len(jobs) == 0 {
			<p class="text-xs font-mono text-white/50">No ML jobs for this video yet.</p>
		}
		</div>
		if len(jobs) > 0 {
		<div class="generated-ml-jobs">
			for _, j := range jobs {
				<article class="border border-white/20 p-2 text-xs font-mono space-y-1 break-words">
					<p class="font-bold">{ mlJobHeadline(j.Kind, j.Status, j.Attempts, j.LastError) }</p>
					if p := mlJobProgress(j.Checkpoint); p != "" {
						<p class="text-white/80">{ p }</p>
					}
					<p class="text-white/60">{ mlJobAttemptLine(j.Attempts, j.Priority, j.Status, j.LastError) }</p>
					<p>Updated: { j.UpdatedAt.Time.UTC().Format("Jan 2 15:04:05 UTC") }</p>
					if j.LockedBy != "" {
						<p>
							Worker: { j.LockedBy } · heartbeat { j.LockedAt.Time.UTC().Format("15:04:05 UTC") }
						</p>
					}
					if j.RetryAt.Valid && j.RetryAt.Time.After(time.Now()) {
						<p>
							Next eligible: { j.RetryAt.Time.UTC().Format("Jan 2 15:04:05 UTC") }
						</p>
					}
					if n := mlJobNotice(j.Kind, j.Status, j.Attempts, j.LastError); n.Headline != "" {
						<p>{ n.Headline }</p>
						if n.Detail != "" {
							<details class="text-white/50">
								<summary>Details</summary>
								<p class="break-words">{ n.Detail }</p>
							</details>
						}
					}
					if mlJobRetryable(j.Status) {
						<button type="button" class="btn-ghost btn-sm" data-on:click={ fmt.Sprintf("@post('/api/ml-jobs/%s/retry?render=1')", j.ID.String()) }>Retry</button>
					}
				</article>
			}
		</div>
		}
	</div>
}

// VideoProcessingNotice shows the outcome of a generated-data request.
templ VideoProcessingNotice(message string) {
	<div id="video-processing-notice" role="status" class="text-xs my-2">{ message }</div>
}
