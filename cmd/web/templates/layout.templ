package templates

import "thirdcoast.systems/rewind/cmd/web/ctxkeys"
import "strconv"

templ Layout(title string, username string) {
	@appLayout(title, username, false) {
		{ children... }
	}
}

templ LayoutFullscreen(title string, username string) {
	@appLayout(title, username, true) {
		{ children... }
	}
}

templ appLayout(title, username string, fullscreen bool) {
	{{ liveProduct, _ := ctx.Value(ctxkeys.LiveProduct).(bool) }}
	{{ productName := "Rewind" }}
	{{ productDescription := "Rewind — self-hosted video archival and management" }}
	if liveProduct {
		{{ productName = "Rewind Live" }}
		{{ productDescription = "Rewind Live — stream everywhere, archive everything, and clip without downloads" }}
	}
	if partial, _ := ctx.Value(ctxkeys.PageNavigation).(bool); partial {
		@pageContent(title, fullscreen, productName) {
			{ children... }
		}
	} else {
		<!DOCTYPE html>
		<html lang="en" data-theme={ appearancePreference(ctx, "theme") } data-color-mode={ appearancePreference(ctx, "color_mode") } data-signals={ appearanceSignals(ctx) } data-attr:data-theme="$uiTheme" data-attr:data-color-mode="$uiColorMode">
			<head>
				<meta charset="UTF-8"/>
				<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
				<meta name="description" content={ productDescription }/>
				<title>{ title } - { productName }</title>
				<link rel="preload" href="/static/fonts/woff/tomorrow-v19-latin-regular.woff2" as="font" type="font/woff2" crossorigin/>
				<link rel="preload" href="/static/fonts/woff/tomorrow-v19-latin-700.woff2" as="font" type="font/woff2" crossorigin/>
				<link rel="stylesheet" href={ versionedAsset(ctx, "/static/dist/fontawesome/all.min.css") }/>
				<link rel="stylesheet" href={ versionedAsset(ctx, "/static/dist/main.css") }/>
				<script src={ versionedAsset(ctx, "/static/dist/main.js") }></script>
			</head>
			<body class={ "flex flex-col min-h-screen bg-black text-white font-mono", templ.KV("page-fullscreen", fullscreen) } data-signals="{agentOpen:false}" data-class:agent-open="$agentOpen" data-sounds-enabled={ interfacePreferenceString(ctx, "sounds_enabled") } data-reduced-motion={ interfacePreferenceString(ctx, "reduced_motion") }>
				@Navbar(username)
				<div id="navigation-bridge" data-on:rewind-navigate__window="@get(evt.detail.url, {headers: {'X-Rewind-Navigation': 'true'}, filterSignals: {exclude: /.*/}, retry: 'never'})"></div>
				<div id="navigation-status" role="status" class="navigation-status" hidden></div>
				@pageContent(title, fullscreen, productName) {
					{ children... }
				}
				if username != "" && !liveProduct {
					@AgentPanel()
				}
				<script type="module">
                    import { getPath, mergePatch, mergePaths } from '/static/dist/datastar.js';
                    window.__dsAPI = { getPath, mergePatch, mergePaths };
                </script>
			</body>
		</html>
	}
}

templ pageContent(title string, fullscreen bool, productName string) {
	<main id="page-content" class="flex-1 min-h-0 flex flex-col" tabindex="-1" data-page-title={ title + " - " + productName } data-page-fullscreen={ strconv.FormatBool(fullscreen) }>
		{ children... }
		if !fullscreen {
			@Footer()
		}
	</main>
}

templ Footer() {
	{{ liveProduct, _ := ctx.Value(ctxkeys.LiveProduct).(bool) }}
	<footer class="bg-black mt-auto border-t-2 border-white/10">
		<div class="mx-auto px-4 py-3">
			if liveProduct {
				<div class="flex flex-col sm:flex-row justify-between items-center gap-4">
					<p class="font-mono text-xs text-white/60 uppercase tracking-wider">
						Stream everywhere. Archive everything. Clip without downloads.
					</p>
					<nav class="flex items-center gap-4 font-mono text-xs uppercase tracking-wider" aria-label="Rewind Live">
						<a href="/features" class="text-white/60 hover:text-white transition">Features</a>
						<a href="/pricing" class="text-white/60 hover:text-white transition">Pricing</a>
						<a href="/docs" class="text-white/60 hover:text-white transition">Docs</a>
					</nav>
				</div>
			} else {
				<div class="flex flex-col sm:flex-row justify-between items-center gap-4">
					<p class="font-mono text-xs text-white/40 uppercase tracking-wider">
						Archival Software &copy; 2026 <a class={ "underline","text-yellow-400 hover:text-yellow-300","underline-yellow-400/70 hover:underline-yellow-400/50" } href="https://thirdcoast.systems" target="_blank">Third Coast Interactive LLC.</a>.
					</p>
					<p class="font-mono text-xs text-white/40 tracking-tighter">
						All content is the property of its respective owners. Use responsibly.
					</p>
				</div>
			}
		</div>
	</footer>
}

templ FooterInline() {
	{{ liveProduct, _ := ctx.Value(ctxkeys.LiveProduct).(bool) }}
	if liveProduct {
		<div class="px-2 py-1 text-xs font-mono text-white/60 leading-tight">
			<p>Stream everywhere. Archive everything. Clip without downloads.</p>
			<nav class="flex items-center gap-3" aria-label="Rewind Live">
				<a href="/features" class="hover:text-white/60 transition">Features</a>
				<a href="/pricing" class="hover:text-white/60 transition">Pricing</a>
				<a href="/docs" class="hover:text-white/60 transition">Docs</a>
			</nav>
		</div>
	} else {
		<div class="px-2 py-1 text-xs font-mono text-white/20 leading-tight">
			<p>&copy; 2026 <a class="text-yellow-400/40 hover:text-yellow-400/60" href="https://thirdcoast.systems" target="_blank">Third Coast Interactive LLC.</a></p>
			<p>Content belongs to respective owners.</p>
		</div>
	}
}
