package templates

import "strconv"

templ StitchWorkspacePage(projectID, username string, readOnly bool) {
	@LayoutFullscreen("Stitch", username) {
		@StitchWorkspace(projectID, readOnly)
	}
}

// StitchWorkspace renders the real-time Stitch non-linear editing workspace.
// The document and revision are loaded by stitch-workspace.js from the project API.
templ StitchWorkspace(projectID string, readOnly bool) {
	<link rel="stylesheet" href={ versionedAsset(ctx, "/static/dist/stitch-workspace.css") }/>
	<div class="stitch-workspace" data-stitch-workspace data-project-id={ projectID } data-readonly={ strconv.FormatBool(readOnly) }>
		<header class="stitch-topbar">
			<a href="/stitch" class="stitch-back" title="Back to STITCH"><i class="fa-sharp fa-solid fa-arrow-left" aria-hidden="true"></i> STITCH</a>
			<span class="stitch-project-id" data-project-label>PROJECT</span>
			if readOnly {
				<span class="stitch-readonly-flag">View only</span>
			}
			<div class="stitch-doc-state" role="status" aria-live="polite"><span data-sync-state>Loading…</span><span data-revision></span></div>
			<div class="stitch-top-actions">
				<button type="button" class="stitch-button" data-action="undo" disabled title="Undo"><i class="fa-sharp fa-solid fa-rotate-left" aria-hidden="true"></i></button>
				<button type="button" class="stitch-button" data-action="redo" disabled title="Redo"><i class="fa-sharp fa-solid fa-rotate-right" aria-hidden="true"></i></button>
				<button type="button" class="stitch-button" data-action="history">History</button>
				<button type="button" class="stitch-button stitch-button-primary" data-action="export">Export</button>
			</div>
		</header>
		<div class="stitch-shell">
			<aside class="stitch-sidebar" aria-label="Workspace tools">
				<section class="stitch-inspector" data-conflict hidden role="alert">
					<p data-conflict-message></p>
					<div class="stitch-inspector-actions">
						<button type="button" data-action="reload-latest">Reload latest</button>
						<button type="button" data-action="apply-draft">Apply draft</button>
					</div>
				</section>
				<nav class="stitch-tabs" aria-label="Editor sections"><button class="stitch-tab is-active" data-tab="edit">Edit</button><button class="stitch-tab" data-tab="captions">Captions</button><button class="stitch-tab" data-tab="layers">Layers</button><button class="stitch-tab" data-tab="assist">Assist</button><button class="stitch-tab" data-tab="youtube">YouTube</button></nav>
				<section class="stitch-inspector" data-panel="edit"><div class="stitch-section-heading">Inspector <span data-selection-count>0 selected</span></div><div data-inspector-content><p class="stitch-muted">Select a segment, caption, or layer to inspect it.</p></div></section>
				<details class="stitch-list-panel" open><summary class="stitch-section-heading">Sources</summary><input class="stitch-source-search" data-source-search placeholder="Search sources"/><div class="stitch-list" data-source-list><p class="stitch-muted">Loading sources…</p></div></details>
				<details class="stitch-list-panel"><summary class="stitch-section-heading">History</summary><div class="stitch-list" data-history-list><p class="stitch-muted">Loading history…</p></div></details>
				<details class="stitch-list-panel" open>
					<summary class="stitch-section-heading">Export</summary>
					<form class="stitch-export-form" data-export-form>
						<label>
							Format
							<select name="format">
								<option value="mp4">MP4</option>
								<option value="webm">WebM</option>
							</select>
						</label>
						<label>
							Quality
							<select name="quality">
								<option value="high">High</option>
								<option value="max">Max</option>
							</select>
						</label>
						<label>
							Captions
							<select name="caption_mode" data-caption-mode>
								<option value="none">None</option>
								<option value="burn">Burn in</option>
								<option value="srt">SRT sidecar</option>
								<option value="vtt">VTT sidecar</option>
							</select>
						</label>
						<label>
							Caption font
							<select name="caption_font" data-font-select="caption"></select>
						</label>
						<label>
							Scope
							<select name="scope">
								<option value="all">Entire sequence</option>
								<option value="selection">Selection</option>
							</select>
						</label>
						<label>
							Loudness
							<input name="loudness" type="number" step="1" value="-14"/>
						</label>
						<button class="stitch-button stitch-button-primary" type="submit">Export</button>
					</form>
					<p class="stitch-muted" data-export-status role="status"></p>
					<div class="stitch-list" data-export-list><p class="stitch-muted">No exports yet</p></div>
				</details>
				<section class="stitch-list-panel" data-list="segments"><div class="stitch-section-heading">Sequence <button class="stitch-icon-button" data-action="add-segment" title="Add source">＋</button></div><div class="stitch-list" data-segment-list><p class="stitch-muted">Loading sequence…</p></div></section>
				<section class="stitch-list-panel" data-panel="captions" hidden>
					<div class="stitch-section-heading">Captions <span><button class="stitch-icon-button" data-action="add-caption" title="Add caption">＋</button> <button class="stitch-icon-button" data-action="import-captions" title="Import from transcript">⇧</button></span></div>
					<form class="stitch-export-form stitch-caption-settings" data-caption-settings>
						<label>
							Burn-in
							<select name="caption_mode" data-caption-mode>
								<option value="none">Off (preview only)</option>
								<option value="burn">Burn in</option>
								<option value="srt">SRT sidecar</option>
								<option value="vtt">VTT sidecar</option>
							</select>
						</label>
						<label>
							Font
							<select name="caption_font" data-font-select="caption"></select>
						</label>
						<p class="stitch-muted">Burn-in writes captions into the export. Install more faces in Settings → Fonts.</p>
					</form>
					<div class="stitch-list" data-caption-list></div>
				</section>
				<section class="stitch-list-panel" data-panel="layers" hidden><div class="stitch-section-heading">Layers</div><div class="stitch-overlay-tools"><button type="button" data-overlay-kind="text">Text</button><button type="button" data-overlay-kind="image">Image</button><button type="button" data-overlay-kind="callout">Callout</button><button type="button" data-overlay-kind="arrow">Arrow</button><button type="button" data-overlay-kind="rectangle">Rect</button><button type="button" data-overlay-kind="ellipse">Ellipse</button><button type="button" data-overlay-kind="freehand">Draw</button></div><p class="stitch-muted" data-overlay-hint>Click a tool to add it on the current frame.</p><div class="stitch-list" data-layer-list></div></section>
				<section class="stitch-assist-panel" data-panel="assist" hidden><div class="stitch-section-heading">Assist</div><div id="stitch-assist-mount"><p class="stitch-muted">Assistant tools will appear here.</p></div></section>
				<section class="stitch-list-panel stitch-youtube-panel" data-panel="youtube" hidden>
					<div class="stitch-section-heading">YouTube</div>
					<p class="stitch-muted">Copy these into YouTube Studio. Saving description and tags does not re-export.</p>
					<form class="stitch-export-form" data-youtube-form onsubmit="return false;">
						<label class="stitch-field">
							Title
							<input type="text" data-youtube-title readonly/>
						</label>
						<div class="stitch-youtube-actions">
							<button type="button" class="stitch-button" data-action="youtube-copy-title">Copy</button>
						</div>
						<label class="stitch-field">
							Description
							<textarea data-youtube-description rows="10" readonly?={ readOnly }></textarea>
						</label>
						<div class="stitch-youtube-actions" data-youtube-description-actions>
							<button type="button" class="stitch-button" data-action="youtube-copy-description">Copy</button>
							if !readOnly {
								<button type="button" class="stitch-button stitch-button-primary" data-action="youtube-save">Save</button>
							}
						</div>
						<label class="stitch-field">
							Tags
							<textarea data-youtube-tags rows="3" readonly?={ readOnly }></textarea>
						</label>
						<div class="stitch-youtube-actions" data-youtube-tags-actions>
							<button type="button" class="stitch-button" data-action="youtube-copy-tags">Copy</button>
							if !readOnly {
								<button type="button" class="stitch-button stitch-button-primary" data-action="youtube-save">Save</button>
							}
						</div>
						<p class="stitch-muted" data-youtube-status role="status"></p>
					</form>
				</section>
			</aside>
			<section class="stitch-stage" aria-label="Preview and timeline">
				<div class="stitch-preview-wrap"><div class="stitch-preview" data-preview><video data-preview-video playsinline preload="metadata"></video><svg class="stitch-overlay" data-overlay-svg viewBox="0 0 1920 1080" aria-label="Overlay canvas"></svg><div class="stitch-live-caption" data-live-caption aria-live="polite"></div><div class="stitch-preview-empty" data-preview-empty>Choose a segment to preview</div><div class="stitch-playhead-readout" data-timecode>00:00:00:00</div></div></div>
				<div class="stitch-transport">
					<button type="button" data-transport="start" title="Go to start"><i class="fa-sharp fa-solid fa-backward-step" aria-hidden="true"></i></button>
					<button type="button" data-transport="prev" title="Previous frame"><i class="fa-sharp fa-solid fa-caret-left" aria-hidden="true"></i></button>
					<button type="button" class="transport-play" data-transport="play" title="Play/Pause"><i class="fa-sharp fa-solid fa-play" aria-hidden="true"></i></button>
					<button type="button" data-transport="next" title="Next frame"><i class="fa-sharp fa-solid fa-caret-right" aria-hidden="true"></i></button>
					<button type="button" data-transport="end" title="Go to end"><i class="fa-sharp fa-solid fa-forward-step" aria-hidden="true"></i></button>
					<span class="transport-spacer"></span>
					<label>Snap <input type="checkbox" data-snap checked/></label>
					<span data-transport-time>00:00:00:00 / 00:00:00:00</span>
				</div>
				<div class="stitch-timeline" data-timeline><div class="timeline-ruler" data-ruler></div><div class="timeline-tracks" data-track-list><p class="stitch-muted">Timeline is loading…</p></div><div class="timeline-playhead" data-playhead></div></div>
				<footer class="stitch-timeline-footer"><div class="timeline-tools"><button data-action="zoom-out" title="Zoom out">−</button><input type="range" min="0" max="1000" value="565" data-zoom aria-label="Timeline zoom" title="80 px/s"/><button data-action="zoom-in" title="Zoom in">＋</button><button data-action="fit" title="Fit sequence">Fit</button><button data-action="fit-selection" title="Fit selection">Selection</button></div><div class="timeline-status"><span data-duration>Duration 00:00:00:00</span><span data-error role="alert"></span></div></footer>
			</section>
		</div>
	</div>
	<script src={ versionedAsset(ctx, "/static/dist/stitch-workspace.js") }></script>
}
