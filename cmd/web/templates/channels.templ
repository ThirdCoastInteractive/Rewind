package templates

import (
	"net/url"

	"thirdcoast.systems/rewind/internal/db"
	"thirdcoast.systems/rewind/pkg/utils/format"
)

// channelViewURL builds the detail-page link for an uploader name. The name
// rides in a query param so slashes and other separators can't break routing.
func channelViewURL(uploader string) string {
	return "/channels/view?name=" + url.QueryEscape(uploader)
}

// channelLibraryURL links into the video library pre-filtered to an uploader.
func channelLibraryURL(uploader string) string {
	return "/videos?uploader=" + url.QueryEscape(uploader)
}

// channelWatchURL links to the follows page with the add form pre-filled.
func channelWatchURL(channelURL, uploader string) string {
	return "/follows?url=" + url.QueryEscape(channelURL) + "&label=" + url.QueryEscape(uploader)
}

templ Channels(username string) {
	@Layout("Channels", username) {
		@Container("") {
			<div class="mb-4 flex items-end justify-between gap-3 flex-wrap" data-signals="{channelFilter: ''}">
				<div>
					<h1 class="page-heading text-xl tracking-tight mb-0.5">Channels</h1>
					<p class="text-xs font-mono text-white/60">Every uploader in the archive, with per-channel stats</p>
				</div>
				<input
					type="text"
					placeholder="Filter channels…"
					data-bind="channelFilter"
					data-on:input__debounce.300ms="@get('/api/channels/index')"
					class="w-64 bg-black border-2 border-white/20 text-white font-mono text-sm px-2 py-1.5 focus:border-white/60 focus:outline-none"
				/>
			</div>
			<div id="channels-list" data-init="@get('/api/channels/index')">
				<div class="border-2 border-white/10 p-4">
					<div class="h-4 w-1/3 skeleton-text"></div>
					<div class="mt-2 h-3 w-1/2 skeleton"></div>
				</div>
			</div>
		}
	}
}

templ ChannelsList(channels []*db.ListChannelsRow) {
	<div id="channels-list">
		if len(channels) == 0 {
			<div class="border-2 border-white/10 p-6 text-center">
				<i class="fa-sharp fa-solid fa-tv text-3xl text-white/20 mb-2" aria-hidden="true"></i>
				<p class="font-mono text-sm text-white/50">No channels</p>
				<p class="font-mono text-xs text-white/30 mt-1">Archive some videos and their uploaders will show up here</p>
			</div>
		} else {
			<div class="border-2 border-white/10 divide-y-2 divide-white/10">
				for _, ch := range channels {
					@ChannelRow(ch)
				}
			</div>
		}
	</div>
}

templ ChannelRow(ch *db.ListChannelsRow) {
	<div class="p-3 flex items-center gap-3">
		<a href={ templ.SafeURL(channelViewURL(ch.Uploader)) } class="shrink-0 w-24 aspect-video bg-white/5 border-2 border-white/10 overflow-hidden hidden sm:block">
			if ch.LatestVideoID.Valid {
				<img
					class="w-full h-full object-cover"
					src={ "/api/videos/" + ch.LatestVideoID.String() + "/thumbnail?w=xs" }
					loading="lazy"
					decoding="async"
					alt=""
				/>
			}
		</a>
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2 flex-wrap">
				<a href={ templ.SafeURL(channelViewURL(ch.Uploader)) } class="font-mono text-sm text-white hover:underline truncate">{ ch.Uploader }</a>
				if ch.Watched {
					<span class="text-xs font-mono uppercase tracking-wider px-1.5 py-0.5 border border-green-500/40 text-green-400" title="This channel is being followed">following</span>
				}
			</div>
			<div class="font-mono text-xs text-white/50 mt-1 flex items-center gap-3 flex-wrap">
				<span>{ format.Itoa64(ch.VideoCount) } videos</span>
				<span>{ format.DurationHuman(ch.TotalDurationSeconds) }</span>
				<span>{ format.Bytes(ch.TotalSizeBytes) }</span>
				if ch.LatestUpload.Valid {
					<span>latest { ch.LatestUpload.Time.Format("2006-01-02") }</span>
				}
			</div>
		</div>
		<div class="flex items-center gap-2 shrink-0">
			<a href={ templ.SafeURL(channelLibraryURL(ch.Uploader)) } class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white">
				<i class="fa-sharp fa-solid fa-film mr-1" aria-hidden="true"></i>Videos
			</a>
			if !ch.Watched && ch.ChannelURL != "" {
				<a href={ templ.SafeURL(channelWatchURL(ch.ChannelURL, ch.Uploader)) } class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white" title="Follow this channel for new videos">
					<i class="fa-sharp fa-solid fa-satellite-dish mr-1" aria-hidden="true"></i>Follow
				</a>
			}
		</div>
	</div>
}

templ ChannelView(overview *db.GetChannelOverviewRow, videos []*db.ListVideosPaginatedRow, username string, edges []*db.ListChannelEdgesForChannelRow) {
	@Layout(overview.Uploader, username) {
		@Container("") {
			<div class="mb-4 flex items-start justify-between gap-3 flex-wrap">
				<div>
					<p class="text-xs font-mono text-white/40 mb-0.5"><a href="/channels" class="hover:text-white/70">Channels</a> /</p>
					<h1 class="page-heading text-xl tracking-tight mb-1">{ overview.Uploader }</h1>
					<div class="font-mono text-xs text-white/50 flex items-center gap-3 flex-wrap">
						<span>{ format.Itoa64(overview.VideoCount) } videos archived</span>
						<span>{ format.DurationHuman(overview.TotalDurationSeconds) }</span>
						<span>{ format.Bytes(overview.TotalSizeBytes) }</span>
						if overview.TotalViews > 0 {
							<span>{ format.Itoa64(overview.TotalViews) } views (source)</span>
						}
						if overview.LatestUpload.Valid {
							<span>latest upload { overview.LatestUpload.Time.Format("2006-01-02") }</span>
						}
					</div>
				</div>
				<div class="flex items-center gap-2">
					if overview.WatchID.Valid {
						<a href="/follows" class="ghost-btn-sm text-green-400 border-green-500/40 hover:border-green-400" title="Following">
							<i class="fa-sharp fa-solid fa-satellite-dish mr-1" aria-hidden="true"></i>Following
						</a>
					} else if overview.ChannelURL != "" {
						<a href={ templ.SafeURL(channelWatchURL(overview.ChannelURL, overview.Uploader)) } class="border-2 bg-black text-white border-white/20 hover:border-white/40 active:scale-95 font-mono text-sm px-3 py-1.5" title="Follow this channel">
							<i class="fa-sharp fa-solid fa-satellite-dish mr-1" aria-hidden="true"></i>Follow this channel
						</a>
					}
					if overview.ChannelURL != "" {
						<form method="POST" action="/channels/view/index-metadata">
							<input type="hidden" name="uploader" value={ overview.Uploader }/>
							<button type="submit" class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white" title="Index descriptions without downloading media">
								<i class="fa-sharp fa-solid fa-list mr-1" aria-hidden="true"></i>Index descriptions
							</button>
						</form>
					}
					<a href={ templ.SafeURL(channelLibraryURL(overview.Uploader)) } class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white">
						<i class="fa-sharp fa-solid fa-magnifying-glass mr-1" aria-hidden="true"></i>Search in library
					</a>
				</div>
			</div>
			if len(edges) > 0 {
				<div class="mb-6">
					<h2 class="sub-heading mb-2">Connected channels</h2>
					<div class="border-2 border-white/10 divide-y-2 divide-white/10">
						for _, e := range edges {
							if e != nil {
								@channelEdgeRow(overview.Uploader, e)
							}
						}
					</div>
				</div>
			}
			if len(videos) > 0 {
				@ResponsiveGrid("videos") {
					for _, video := range videos {
						@VideoCard(video)
					}
				}
			} else {
				@EmptyState("video", "No videos", "Nothing archived from this channel yet.")
			}
		}
	}
}

templ channelEdgeRow(self string, e *db.ListChannelEdgesForChannelRow) {
	<div class="p-3 flex items-center gap-3 flex-wrap font-mono text-sm">
		@channelEdgePeer(self, e.FromUploader, e.FromPlatform)
		<span class="badge">{ e.Kind }</span>
		@channelEdgeToPeer(self, e)
		<span class="text-xs text-white/40">×{ format.Itoa64(int64(e.Weight)) }</span>
		if e.Evidence != "" {
			<span class="text-xs text-white/40 truncate">{ evidenceSnippet(e.Evidence, 80) }</span>
		}
	</div>
}

templ channelEdgePeer(self, uploader, platform string) {
	if uploader == self {
		<span class="text-white">{ uploader }</span>
	} else if uploader != "" {
		<a href={ templ.SafeURL(channelViewURL(uploader)) } class="text-white hover:underline">{ uploader }</a>
	} else {
		<span class="text-white/50">unknown</span>
	}
	if platform != "" {
		<span class="text-xs text-white/30">{ platform }</span>
	}
}

templ channelEdgeToPeer(self string, e *db.ListChannelEdgesForChannelRow) {
	if e.ToUploader != "" {
		@channelEdgePeer(self, e.ToUploader, e.ToPlatform)
	} else if e.ToURL != "" {
		<span class="text-white/70 truncate">{ e.ToURL }</span>
	} else {
		<span class="text-white/50">unknown</span>
	}
}
