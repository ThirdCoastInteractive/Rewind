package templates

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/dustin/go-humanize"
	"github.com/jackc/pgx/v5/pgtype"
	"thirdcoast.systems/rewind/internal/db"
)

// watchFormSignals builds the add form's DataStar signals JSON, optionally
// pre-filling URL and label (e.g. arriving from a channel page).
func watchFormSignals(prefillURL, prefillLabel string) string {
	b, err := json.Marshal(map[string]any{
		"watchUrl":        prefillURL,
		"watchSchedule":   "@daily",
		"watchCustomCron": "",
		"watchLabel":      prefillLabel,
		"watchBackfill":   false,
	})
	if err != nil {
		return `{watchUrl: '', watchSchedule: '@daily', watchCustomCron: '', watchLabel: '', watchBackfill: false}`
	}
	return string(b)
}

// watchRelTime renders a nullable timestamp as a relative time ("3 minutes ago",
// "57 minutes from now"), or a dash when unset.
func watchRelTime(t pgtype.Timestamptz) string {
	if !t.Valid {
		return "—"
	}
	return humanize.Time(t.Time)
}

// watchName returns the watch's label, falling back to its URL.
func watchName(w *db.ListWatchedChannelsRow) string {
	if l := strings.TrimSpace(w.Label); l != "" {
		return l
	}
	return w.URL
}

templ Watches(watches []*db.ListWatchedChannelsRow, prefillURL string, prefillLabel string, username string) {
	@Layout("Follows", username) {
		@Container("") {
			<div class="mb-4">
				<h1 class="page-heading text-xl tracking-tight mb-0.5">Follows</h1>
				<p class="text-xs font-mono text-white/60">Scan channels for new videos on a schedule</p>
			</div>
			@WatchAddForm(prefillURL, prefillLabel)
			@WatchesSection(watches, "")
		}
	}
}

templ WatchAddForm(prefillURL string, prefillLabel string) {
	<div
		class="border-2 border-white/10 p-3 mb-4"
		data-signals={ watchFormSignals(prefillURL, prefillLabel) }
	>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
			<div class="md:col-span-2">
				<label class="block text-xs font-mono uppercase tracking-wider text-white/60 mb-1">Channel or playlist URL</label>
				<input
					type="text"
					data-bind="watchUrl"
					placeholder="https://www.youtube.com/@channel"
					class="w-full bg-black border-2 border-white/20 text-white font-mono text-sm px-2 py-1.5 focus:border-white/60 focus:outline-none"
				/>
			</div>
			<div>
				<label class="block text-xs font-mono uppercase tracking-wider text-white/60 mb-1">Label <span class="text-white/30 normal-case">(optional, auto-filled from channel)</span></label>
				<input
					type="text"
					data-bind="watchLabel"
					placeholder="My favorite channel"
					class="w-full bg-black border-2 border-white/20 text-white font-mono text-sm px-2 py-1.5 focus:border-white/60 focus:outline-none"
				/>
			</div>
			<div>
				<label class="block text-xs font-mono uppercase tracking-wider text-white/60 mb-1">Scan schedule</label>
				<div class="flex gap-2">
					<select
						data-bind="watchSchedule"
						class="bg-black border-2 border-white/20 text-white font-mono text-sm px-2 py-1.5 focus:border-white/60 focus:outline-none"
					>
						<option value="@every 15m">Every 15 minutes</option>
						<option value="@hourly">Every hour</option>
						<option value="0 */6 * * *">Every 6 hours</option>
						<option value="@daily" selected>Daily</option>
						<option value="@weekly">Weekly</option>
						<option value="custom">Custom cron…</option>
					</select>
					<input
						type="text"
						data-bind="watchCustomCron"
						data-show="$watchSchedule == 'custom'"
						placeholder="30 4 * * 1-5"
						class="flex-1 bg-black border-2 border-white/20 text-white font-mono text-sm px-2 py-1.5 focus:border-white/60 focus:outline-none"
					/>
				</div>
			</div>
			<div class="md:col-span-2 flex items-center justify-between gap-4 flex-wrap">
				<label class="flex items-center gap-2 cursor-pointer">
					<input type="checkbox" data-bind="watchBackfill" class="w-4 h-4 bg-black border-2 border-white/40"/>
					<span class="text-xs font-mono text-white/70">
						Backfill: also archive the channel's existing videos
						<span class="block text-white/40">unchecked = only videos published after the follow is added</span>
					</span>
				</label>
				<button
					type="button"
					data-on:click="@post('/api/watches')"
					data-indicator:addingwatch
					class="border-2 bg-black text-white border-white/20 hover:border-white/40 active:scale-95 font-mono text-sm px-4 py-1.5"
				>
					<i class="fa-sharp fa-solid fa-satellite-dish mr-1" aria-hidden="true"></i>
					Follow Channel
					<span data-show="$addingwatch" class="ml-1 text-white/50">…</span>
				</button>
			</div>
		</div>
	</div>
}

templ WatchesSection(watches []*db.ListWatchedChannelsRow, errMsg string) {
	<div id="watches-section">
		if errMsg != "" {
			<div class="border-2 border-red-500/40 bg-red-500/10 text-red-300 font-mono text-xs p-2 mb-4">
				<i class="fa-sharp fa-solid fa-triangle-exclamation mr-1" aria-hidden="true"></i>
				{ errMsg }
			</div>
		}
		if len(watches) == 0 {
			<div class="border-2 border-white/10 p-6 text-center">
				<i class="fa-sharp fa-solid fa-satellite-dish text-3xl text-white/20 mb-2" aria-hidden="true"></i>
				<p class="font-mono text-sm text-white/50">No channels followed yet</p>
				<p class="font-mono text-xs text-white/30 mt-1">Add a channel above — new uploads will be archived automatically</p>
			</div>
		} else {
			<div class="border-2 border-white/10 divide-y-2 divide-white/10">
				for _, w := range watches {
					@WatchRow(w)
				}
			</div>
		}
	</div>
}

templ WatchRow(w *db.ListWatchedChannelsRow) {
	<div class="p-3">
		<div class="flex items-start justify-between gap-3 flex-wrap">
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2 flex-wrap">
					<span class="font-mono text-sm text-white truncate">{ watchName(w) }</span>
					if w.Enabled {
						<span class="text-xs font-mono uppercase tracking-wider px-1.5 py-0.5 border border-green-500/40 text-green-400">following</span>
					} else {
						<span class="text-xs font-mono uppercase tracking-wider px-1.5 py-0.5 border border-white/20 text-white/40">paused</span>
					}
					<span class="text-xs font-mono px-1.5 py-0.5 border border-white/20 text-white/60">{ w.CronSchedule }</span>
					if w.Backfill {
						<span class="text-xs font-mono uppercase tracking-wider px-1.5 py-0.5 border border-white/20 text-white/40">backfill</span>
					}
				</div>
				<a href={ templ.SafeURL(w.URL) } target="_blank" rel="noopener" class="block font-mono text-xs text-white/40 hover:text-white/70 truncate mt-1">{ w.URL }</a>
				<div class="font-mono text-xs text-white/50 mt-1 flex items-center gap-3 flex-wrap">
					if w.LastScanAt.Valid {
						if w.LastScanStatus != nil && *w.LastScanStatus == "error" {
							<span class="text-red-400" title={ watchErrText(w) }>
								<i class="fa-sharp fa-solid fa-circle-xmark mr-1" aria-hidden="true"></i>
								scan failed { watchRelTime(w.LastScanAt) }
							</span>
						} else {
							<span>
								last scan { watchRelTime(w.LastScanAt) } · { fmt.Sprintf("%d new", w.LastScanFound) }
							</span>
						}
					} else {
						<span>never scanned</span>
					}
					if w.Enabled {
						<span>next { watchRelTime(w.NextScanAt) }</span>
					}
					<span>{ fmt.Sprintf("%d archived", w.TrackedCount) }</span>
					<span class="text-white/30">by { w.CreatedByName }</span>
				</div>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<button
					type="button"
					data-on:click={ fmt.Sprintf("@post('/api/watches/%s/scan')", w.ID.String()) }
					title="Scan now"
					class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white"
				>
					<i class="fa-sharp fa-solid fa-radar mr-1" aria-hidden="true"></i>Scan now
				</button>
				<button
					type="button"
					data-on:click={ fmt.Sprintf("@post('/api/watches/%s/toggle')", w.ID.String()) }
					class="ghost-btn-sm text-white/60 border-white/40 hover:border-white hover:text-white"
				>
					if w.Enabled {
						<i class="fa-sharp fa-solid fa-pause mr-1" aria-hidden="true"></i>Pause
					} else {
						<i class="fa-sharp fa-solid fa-play mr-1" aria-hidden="true"></i>Resume
					}
				</button>
				<button
					type="button"
					data-on:click={ fmt.Sprintf("confirm('Stop following this channel? Archived videos are kept.') && @post('/api/watches/%s/delete')", w.ID.String()) }
					title="Stop following this channel? Archived videos are kept."
					class="ghost-btn-sm text-red-400/70 border-red-500/40 hover:border-red-400 hover:text-red-300"
				>
					<i class="fa-sharp fa-solid fa-trash" aria-hidden="true"></i>
				</button>
			</div>
		</div>
	</div>
}

// watchErrText returns the last scan error, trimmed for display.
func watchErrText(w *db.ListWatchedChannelsRow) string {
	if w.LastScanError == nil {
		return ""
	}
	msg := strings.TrimSpace(*w.LastScanError)
	if len(msg) > 300 {
		msg = msg[:300] + "…"
	}
	return msg
}
